{
  "name": "@reelindo/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker:video": "tsx src/workers/video-worker.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "start": "node --import ./instrument.mjs dist/server.js",
    "start:worker": "node --import ./instrument.mjs dist/workers/video-worker.js",
    "lint": "eslint src ../../database/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate --schema ../../database/schema.prisma",
    "db:migrate": "prisma migrate dev --schema ../../database/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema ../../database/schema.prisma",
    "db:seed": "tsx ../../database/seed.ts"
  },
  "prisma": {
    "seed": "tsx ../../database/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.899.0",
    "@aws-sdk/s3-request-presigner": "^3.899.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/client": "^6.16.2",
    "@sentry/node": "^11.8.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.58.5",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.1",
    "ioredis": "^5.7.0",
    "socket.io": "^4.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.6",
    "eslint": "^9.36.0",
    "jest": "^29.7.0",
    "prisma": "^6.16.2",
    "ts-jest": "^29.2.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
